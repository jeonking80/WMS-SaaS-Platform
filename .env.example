# Copy to .env.local and set a local development password.
# Never commit .env.local or use production databases for integration tests.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
# URL-encode the password component when it contains reserved URL characters.
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/wms_lite
MIGRATION_DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/wms_lite
TEST_DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:5433/wms_lite_test
# P0 uses a local bootstrap DB account; split app/migration roles in P1.
