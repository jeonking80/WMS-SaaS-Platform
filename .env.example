# Copy to .env.local and set a local development password.
# Never commit .env.local or use production databases for integration tests.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
# URL-encode the password component when it contains reserved URL characters.
BOOTSTRAP_DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/wms_lite
DATABASE_URL=postgresql://wms_app:YOUR_APP_PASSWORD@127.0.0.1:5432/wms_lite
MIGRATION_DATABASE_URL=postgresql://wms_migrator:YOUR_MIGRATOR_PASSWORD@127.0.0.1:5432/wms_lite
TEST_DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:5433/wms_lite_test
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
DEMO_PASSWORD=
# env:init creates local random secrets; never use these demo accounts in production.
