SIM_HOST=127.0.0.1
SIM_PORT=4310
SIM_DATABASE=./data/simulator.sqlite
# Private deployment requires an access token; local UI can omit it.
SIM_UI_TOKEN=
WMS_URL=http://127.0.0.1:3000
WMS_COMPANY_ID=
WMS_SOURCE_KEY=
WMS_PROCESS_KEY=
WMS_WORKER_KEY=
# Optional comma-separated distinct worker keys (1~10); overrides WMS_WORKER_KEY
WMS_WORKER_KEYS=
WMS_APPROVER_KEY=
# Separate supervisor automation key (read/write/approve) for role and actual task handover
WMS_SUPERVISOR_KEY=
# Optional separate master preparation key
WMS_PREPARE_KEY=
