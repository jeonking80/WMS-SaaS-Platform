{
  "name": "wms-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --project integration",
    "test:e2e": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "db:check": "node --env-file-if-exists=.env.local scripts/db-check.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db-seed.mjs",
    "env:init": "node scripts/env-init.mjs",
    "db:bootstrap": "node --env-file-if-exists=.env.local scripts/db-bootstrap.mjs",
    "auth:seed": "node --env-file-if-exists=.env.local scripts/auth-seed.mjs",
    "db:setup": "npm run db:bootstrap && npm run db:migrate && npm run db:bootstrap -- --grant && npm run db:seed && npm run auth:seed",
    "verify": "npm run typecheck && npm run test:unit && npm run test:simulator && npm run test:integration && npm run build && npm run test:e2e",
    "test:performance": "node --env-file-if-exists=.env.local scripts/performance.mjs",
    "db:backup": "node --env-file-if-exists=.env.local scripts/db-backup.mjs",
    "db:restore": "node --env-file-if-exists=.env.local scripts/db-restore.mjs",
    "test:restore": "node --env-file-if-exists=.env.local scripts/verify-restore.mjs",
    "demo:seed": "node --env-file-if-exists=.env.local scripts/demo-seed.mjs",
    "demo:smoke": "node --env-file-if-exists=.env.local scripts/demo-smoke.mjs",
    "test:simulator": "npm --prefix apps/simulator test",
    "company:provision": "node --env-file-if-exists=.env.local scripts/provision-company.mjs",
    "operations:monitor": "node --env-file-if-exists=.env.local scripts/v2-monitor.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.11",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "node-pg-migrate": "9.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
